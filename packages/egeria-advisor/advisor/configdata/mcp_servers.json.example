{
  "mcpServers": {
    "pyegeria": {
      "_comment": "Launch from THIS project's own venv (installed pyegeria package) via `-m`, not a separate egeria-python checkout's venv with a direct file path. A separate checkout can drift out of sync with what's actually pip-installed here — e.g. missing PYEGERIA_MCP_REPORT_TIMEOUT/PYEGERIA_TIMEOUT_SECONDS env-var support that a newer installed version already has. See docs/PROJECT_SUMMARY.md Phase 22.",
      "command": "/absolute/path/to/egeria-advisor/.venv/bin/python",
      "args": [
        "-m", "pyegeria.core.mcp_server"
      ],
      "env": {
        "EGERIA_USER": "erinoverview",
        "EGERIA_VIEW_SERVER": "qs-view-server",
        "EGERIA_PASSWORD": "secret",
        "EGERIA_VIEW_SERVER_URL": "https://localhost:9443"
      },
      "enabled": true,
      "description": "PyEgeria MCP server for reports and Dr. Egeria commands"
    }
  },
  "settings": {
    "auto_discover_tools": true,
    "tool_timeout": 30,
    "max_concurrent_tools": 5,
    "enable_tool_caching": true,
    "cache_ttl": 300
  }
}