{
  "about": "The fixed 30-question set for the EA re-base prototype (BRIEF-EA-REBASE-PROTOTYPE-2026-11-13 §2). 15 question_spec questions from the specs EA indexes (pyegeria built-in specs and the DrE-generated specs), 10 from the Coco workbooks (the CDO sheet's registers, the Data Hub's products, the Catalog Health sheet), 5 deliberately ambiguous. `expect` is what the rubric scorer looks for; it is never shown to the elicitor. `replies` overrides the harness's scripted replies (default: accept the proposal, accept the columns, generate).",
  "sources": {
    "plain": "config/report_specs/plain_spec_question_specs_batch1.json (question_spec of pyegeria built-in specs; each label resolves in pyegeria's registry)",
    "dre": "config/report_specs/report_specs_annotated.json (question_spec of the DrE-generated specs)",
    "cdo": "egeria-workspaces data-governance-program/chief-data-officer-dashboard.md (the CDO sheet's three register Reports; ~/.re-gate/CDO-REPORTS-TABLE-2026-11-12.md)",
    "datahub": "Coco 1. Data Hub workbooks (digital-product-subscriptions.md; ~/.re-gate/DATAHUB-SUBSCRIPTIONS-EXISTENCE-CHECK-2026-11-12.md)",
    "health": "Catalog Health sheet (~/.re-gate/BRIEF-USEFUL-SHEETS-AND-SAVED-QUERY-REPORTS-2026-11-10.md §2.1)",
    "ambiguous": "written for this prototype"
  },
  "notes": [
    "No spec EA indexes has a question_spec for Risk; Risk is covered by the Coco CDO risk register (C02, C03).",
    "Questions with a [placeholder] in their source are left out, or filled with a Coco name, so every question is runnable as written."
  ],
  "questions": [
    {"id": "B01", "set": "builtin", "source": "plain:Asset-Graph", "question": "Show me the data flow and lineage for the assets in our catalog.",
     "expect": {"target_type": "Asset", "condition": null, "columns": ["Display Name", "lineage / data flow"]}},
    {"id": "B02", "set": "builtin", "source": "plain:Projects", "question": "What projects are currently active?",
     "expect": {"target_type": "Project", "condition": "status ACTIVE", "columns": ["Display Name", "Status"]}},
    {"id": "B03", "set": "builtin", "source": "plain:Projects", "question": "Show me projects by priority.",
     "expect": {"target_type": "Project", "condition": "sorted by priority", "columns": ["Display Name", "Priority"]}},
    {"id": "B04", "set": "builtin", "source": "plain:Glossary-Terms", "question": "Which glossary terms have usage notes?",
     "expect": {"target_type": "GlossaryTerm", "condition": "usage present", "columns": ["Display Name", "Usage"]}},
    {"id": "B05", "set": "builtin", "source": "plain:Glossary-Terms", "question": "Which glossary terms are still in draft status?",
     "expect": {"target_type": "GlossaryTerm", "condition": "status DRAFT", "columns": ["Display Name", "Status"]}},
    {"id": "B06", "set": "builtin", "source": "dre:Glossary-Term-DrE-Advanced", "question": "Can I see all glossary terms with their effective dates?",
     "expect": {"target_type": "GlossaryTerm", "condition": null, "columns": ["Display Name", "Effective From", "Effective To"]}},
    {"id": "B07", "set": "builtin", "source": "plain:Collections", "question": "Which collections have no classification?",
     "expect": {"target_type": "Collection", "condition": "no classification", "columns": ["Display Name", "Classifications"]}},
    {"id": "B08", "set": "builtin", "source": "plain:Collections", "question": "What collections were created recently?",
     "expect": {"target_type": "Collection", "condition": "sorted/filtered by create time", "columns": ["Display Name", "Create Time"]}},
    {"id": "B09", "set": "builtin", "source": "plain:Digital-Products", "question": "What data products are available?",
     "expect": {"target_type": "DigitalProduct", "condition": null, "columns": ["Display Name", "Description"]}},
    {"id": "B10", "set": "builtin", "source": "plain:Digital-Products", "question": "Which products are still in development or draft?",
     "expect": {"target_type": "DigitalProduct", "condition": "status draft/in development", "columns": ["Display Name", "Status / Maturity"]}},
    {"id": "B11", "set": "builtin", "source": "plain:Digital-Products", "question": "Which products are nearing end of service life?",
     "expect": {"target_type": "DigitalProduct", "condition": "service life / withdrawal date near", "columns": ["Display Name", "Service Life", "Withdrawal Date"]}},
    {"id": "B12", "set": "builtin", "source": "plain:Digital-Product-Catalog", "question": "What data product catalogs exist?",
     "expect": {"target_type": "DigitalProductCatalog", "condition": null, "columns": ["Display Name", "Description"]}},
    {"id": "B13", "set": "builtin", "source": "dre:Governance-Metric-DrE-Basic", "question": "What are the current governance metrics for our organization?",
     "expect": {"target_type": "GovernanceMetric", "condition": null, "columns": ["Display Name", "Measurement / Target"]}},
    {"id": "B14", "set": "builtin", "source": "plain:Governance-Controls", "question": "What measurements and targets are defined for governance controls?",
     "expect": {"target_type": "GovernanceControl", "condition": null, "columns": ["Display Name", "Measurement", "Target"]}},
    {"id": "B15", "set": "builtin", "source": "plain:Governance Policies", "question": "Which governance policies are active and approved?",
     "expect": {"target_type": "GovernancePolicy", "condition": "status ACTIVE/APPROVED", "columns": ["Display Name", "Status"]}},

    {"id": "C01", "set": "coco", "source": "cdo:My Ninety Day Plan Progress", "question": "Show the campaign, phases and tasks of Jules Keeper's ninety day plan with their current status.",
     "expect": {"target_type": "Project", "condition": "JulesKeeper:: plan items", "columns": ["Display Name", "Status"]}},
    {"id": "C02", "set": "coco", "source": "cdo:Company Risk Register", "question": "List the risks in the company risk register.",
     "expect": {"target_type": "Risk", "condition": null, "columns": ["Display Name", "Description"]}},
    {"id": "C03", "set": "coco", "source": "cdo:Company Risk Register", "question": "Which risks in the risk register have the highest importance?",
     "expect": {"target_type": "Risk", "condition": "sorted by importance", "columns": ["Display Name", "Importance"]}},
    {"id": "C04", "set": "coco", "source": "cdo:Governance Metric Register", "question": "What has the data governance program committed to measure? List every governance metric with its domain.",
     "expect": {"target_type": "GovernanceMetric", "condition": null, "columns": ["Display Name", "Domain", "Measurement"]}},
    {"id": "C05", "set": "coco", "source": "datahub:digital products", "question": "Which digital products does the Coco Pharmaceuticals data hub offer, and who is the product manager for each?",
     "expect": {"target_type": "DigitalProduct", "condition": null, "columns": ["Display Name", "Product Manager"]}},
    {"id": "C06", "set": "coco", "source": "datahub:digital products", "question": "Which digital products have no product manager?",
     "expect": {"target_type": "DigitalProduct", "condition": "no product manager", "columns": ["Display Name", "Product Manager"]}},
    {"id": "C07", "set": "coco", "source": "datahub:subscriptions", "question": "What subscription types can I choose from for the data hub's products?",
     "expect": {"target_type": "SubscriptionType", "condition": null, "columns": ["Display Name", "Description"]}},
    {"id": "C08", "set": "coco", "source": "datahub:subscriptions", "question": "List the digital subscriptions that exist, with their status.",
     "expect": {"target_type": "DigitalSubscription", "condition": null, "columns": ["Display Name", "Status"]}},
    {"id": "C09", "set": "coco", "source": "health:Ownership %", "question": "Which assets in the catalog have no owner?",
     "expect": {"target_type": "Asset", "condition": "no owner", "columns": ["Display Name", "Owner"]}},
    {"id": "C10", "set": "coco", "source": "health:Stale assets", "question": "Which assets haven't been updated in the last 180 days?",
     "expect": {"target_type": "Asset", "condition": "update time older than 180 days", "columns": ["Display Name", "Update Time"]}},

    {"id": "A01", "set": "ambiguous", "source": "ambiguous", "question": "Show me the important stuff.",
     "expect": {"clarify": true}},
    {"id": "A02", "set": "ambiguous", "source": "ambiguous", "question": "What's wrong with our data?",
     "expect": {"clarify": true}},
    {"id": "A03", "set": "ambiguous", "source": "ambiguous", "question": "Give me a report on everything that changed.",
     "expect": {"clarify": true}},
    {"id": "A04", "set": "ambiguous", "source": "ambiguous", "question": "Who owns it?",
     "expect": {"clarify": true}},
    {"id": "A05", "set": "ambiguous", "source": "ambiguous", "question": "Build me a dashboard for the CDO.",
     "expect": {"clarify": true}}
  ]
}
