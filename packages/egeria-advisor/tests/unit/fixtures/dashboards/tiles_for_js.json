   "rows": [
    {
     "zone_membership": [],
     "category": "Event Security",
     "description": "**Likelihood:** Low — there is no specific intelligence suggesting Coco Pharmaceuticals or its conference is a targeted risk, but any large public gathering carries a baseline exposure to this threat. **Impact:** Critical — any incident affecting attendee safety would be catastrophic in human terms and would carry severe legal and reputational consequences for the organisation. **Overall rating:** Medium-High, reflecting low likelihood combined with critical impact.",
     "display_name": "Terrorism-Related Incident at the Annual Conference",
     "guid": "9c4b7824-d2f0-4b0d-8900-3042b7b6ba2d",
     "legal": null,
     "qualified_name": "CocoPharma::Risk::TerrorismIncidentAtAnnualConference",
     "url": null,
     "version_identifier": "1.0",
     "authors": [
      "Ivor Padlock"
     ],
     "content_status": "ACTIVE",
     "domain_identifier": 0,
     "implications": [
      "Public protection procedures (evacuation, invacuation, lockdown, communication) must be documented and rehearsed before each conference",
      "Venue security assessments must be refreshed for each event, particularly if attendance approaches the 800-attendee enhanced tier threshold",
      "Staff working at the event must be briefed on their role in the public protection procedures"
     ],
     "importance": "Medium-High",
     "outcomes": null,
     "results": null,
     "scope": null,
     "summary": "Coco Pharmaceuticals' annual conference, attracting around 700 attendees, could be the scene of, or affected by, a terrorism-related incident.",
     "usage": null
    },
    {
     "zone_membership": [],
     "category": "Knowledge Management",
     "description": "**Likelihood:** Medium — this pattern already exists at Coco Pharmaceuticals today, as a direct consequence of historically siloed, informally governed departments; the common glossary intended to fix it is still being populated. **Impact:** Medium-High — reports and analytics that silently combine inconsistently defined data can drive incorrect business, clinical, or financial decisions without any error being visible to the people relying on them. **Overall rating:** Medium-High.",
     "display_name": "Inconsistent Data Definitions Undermining Cross-Department Reporting",
     "guid": "7875cf66-5e1e-4130-bbe9-a6af7901c657",
     "legal": null,
     "qualified_name": "CocoPharma::Risk::InconsistentDataDefinitionsReportingErrors",
     "url": null,
     "version_identifier": "1.0",
     "authors": [
      "Jules Keeper"
     ],
     "content_status": "ACTIVE",
     "domain_identifier": 0,
     "implications": [
      "Cross-department reports must state which glossary definitions their inputs conform to",
      "New data sharing between departments should trigger a check that shared terms have agreed definitions",
      "Discrepancies discovered between departmental definitions must be escalated for resolution, not silently reconciled"
     ],
     "importance": "Medium-High",
     "outcomes": null,
     "results": null,
     "scope": null,
     "summary": "Different departments could continue to define the same data (such as \"patient\", \"batch\", or \"revenue\") differently, causing combined reports to be wrong without anyone noticing.",
     "usage": null
    },
    {
     "zone_membership": [],
     "category": "Knowledge Management",
     "description": "**Likelihood:** Medium — Coco Pharmaceuticals has historically relied on informal knowledge sharing, and the formal metadata-driven governance program is still being built out, so there is currently more undocumented knowledge than documented. **Impact:** High — loss of this knowledge could stall governance activity, cause inconsistent decisions by successors, and delay onboarding of replacement staff. **Overall rating:** High.",
     "display_name": "Loss of Undocumented Governance Knowledge on Staff Departure",
     "guid": "20ba93d1-e36a-4120-9b24-c1b4753ce7a9",
     "legal": null,
     "qualified_name": "CocoPharma::Risk::LossOfUndocumentedGovernanceKnowledge",
     "url": null,
     "version_identifier": "1.0",
     "authors": [
      "Jules Keeper"
     ],
     "content_status": "ACTIVE",
     "domain_identifier": 0,
     "implications": [
      "Governance decisions and rationale must be captured in the metadata catalog as they are made, not reconstructed afterwards",
      "Domain leads should identify and document undocumented knowledge as a standing responsibility, not a one-off exercise",
      "Handover documentation must be required as part of any planned staff transition"
     ],
     "importance": "High",
     "outcomes": null,
     "results": null,
     "scope": null,
     "summary": "Departure of a domain lead or other key member of staff could remove undocumented knowledge of governance decisions, data definitions, or processes.",
     "usage": null
    }
   ],
   "total": 12,
   "total_basis": "one page",
   "shown": 12,
   "notes": []
  }
 },
