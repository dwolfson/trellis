# Egeria Configuration
# EGERIA_VIEW_SERVER_URL/EGERIA_VIEW_SERVER take priority over
# config/mcp_servers.json's defaults (see advisor/mcp_config.py). Leave both
# commented out to use config/mcp_servers.json's defaults (local Egeria at
# localhost:9443); set them to point this deployment at a different Egeria
# instance without editing the committed JSON config.
#
# IMPORTANT: don't assume "something responds on localhost:9443" means that's
# the right Egeria — this machine may ALSO run its own separate local Egeria
# (e.g. a local dev/quickstart stack) seeded with the same standard sample
# data as a real target elsewhere, so report output can look identical between
# two genuinely different servers. If a connection to the intended host fails
# and localhost "just works," verify they're actually the same server (compare
# a specific element's GUID via find_elements_by_property_value, not just
# whether output looks right) before concluding localhost is correct — a
# dropped port forward masquerading as "must need localhost instead" cost
# real debugging time once already; see docs/PROJECT_SUMMARY.md Phase 22.
# EGERIA_VIEW_SERVER_URL=https://localhost:9443
# EGERIA_VIEW_SERVER=view-server

# MCP tool-call timeout in seconds (config/mcp_servers.json's default is 30,
# calibrated for local Egeria). Raise this if pointing at a genuinely remote
# Egeria instance — real network latency can exceed 30s for report execution.
# Three separate layers all default to ~30s and need raising together for
# this to actually help — see docs/PROJECT_SUMMARY.md Phase 22 before assuming
# one env var is enough.
# ADVISOR_MCP_TOOL_TIMEOUT=90
# PYEGERIA_MCP_REPORT_TIMEOUT=90
# PYEGERIA_TIMEOUT_SECONDS=90

# .env-backed service-account fallback, used by advisor.auth.resolve_egeria_credentials()
# only when a request has no logged-in session (background/anonymous use — most
# live-Egeria actions require login via require_egeria_user() and never hit this).
EGERIA_USER=garygeeke
EGERIA_PASSWORD=secret

# Shared HS256 secret with a Portal for POST /api/auth/portal token exchange
# (advisor.auth.exchange_portal_token) — leave blank to disable Portal SSO.
ADVISOR_PORTAL_SECRET=

# Extra CORS origin(s) allowed to call the API cross-origin (comma-separated),
# on top of localhost (always allowed). Needed if a Portal frontend on a
# different origin calls this Advisor's API directly.
# ADVISOR_EXTRA_CORS_ORIGINS=https://your-portal-host.example.com

# Web UI ports/bind address, used by scripts/run_web.sh. HTTP is always served;
# HTTPS only starts when both SSL cert vars below are set to existing files.
# ADVISOR_BIND_HOST=0.0.0.0
# ADVISOR_HTTP_PORT=8880
# ADVISOR_HTTPS_PORT=8881

# TLS cert/key file paths (e.g. a wildcard cert for your domain) — set both to
# enable HTTPS via scripts/run_web.sh, served alongside HTTP, not instead of it
# (uvicorn only serves one scheme per process, so this runs two processes).
# ADVISOR_SSL_CERTFILE=/path/to/fullchain.pem
# ADVISOR_SSL_KEYFILE=/path/to/privkey.pem

# Ollama Configuration (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_CODE_MODEL=codellama:13b
OLLAMA_TEMPERATURE=0.7

# Model tier: dev | demo-gpu | demo-cpu (default: dev). Resolves per-slot
# models, Ollama's num_ctx ceiling, and the RAG context token budget
# together — see docs/runtime-architecture-plan.md §5 and
# advisor/config.py's TIER_PRESETS. Overrides advisor.yaml's llm.tier.
# ADVISOR_MODEL_TIER=dev

# Embedding Model (Local)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Hugging Face Hub network behavior for the embedding model above.
# First run needs network access once to download/cache the model
# (e.g. `huggingface-cli download sentence-transformers/all-MiniLM-L6-v2`,
# cached under ~/.cache/huggingface/hub/). After that, uncomment the two
# OFFLINE lines below to stop the client from making a HEAD request to
# huggingface.co on every startup to check for updates — useful if you're
# seeing ReadTimeoutError on huggingface.co. Leave commented on first run.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
# Raise this instead of/in addition to the above if you'd rather keep the
# update check but just give it more time than the 10s default.
# HF_HUB_DOWNLOAD_TIMEOUT=60

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=egeria-advisor
MLFLOW_ENABLE_TRACKING=true

# Phoenix Arize Configuration (optional)
PHOENIX_ENABLE=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# Advisor Configuration
# Writable root for Advisor's own state (embedding/analytics cache, feedback
# logs, incremental-index state) -- see advisor/config.py's
# resolve_advisor_data_root(). Defaults to ./data (relative to cwd), which
# works for a native checkout; set this to an absolute, writable path (e.g.
# inside a container whose default cwd isn't writable by its non-root user).
# ADVISOR_DATA_PATH=/path/to/writable/advisor-data

# The read-only egeria-python SOURCE checkout the data-prep pipeline ingests
# from. Unset, it resolves from advisor.yaml's data_sources.egeria_python_path,
# then ~/localGit/egeria-python.
#
# Until 2026-09-06 this answered to ADVISOR_DATA_PATH too -- one env var name
# for two unrelated things -- so setting it for either meaning silently
# redirected the other, sending the cache/feedback/index writes above into a
# source checkout. Separate names now; ADVISOR_DATA_PATH no longer affects it.
# ADVISOR_EGERIA_PYTHON_PATH=/path/to/egeria-python
ADVISOR_CACHE_DIR=./data/cache
ADVISOR_LOG_LEVEL=INFO