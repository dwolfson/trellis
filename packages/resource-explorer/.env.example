# GitHub
GITHUB_TOKEN=                              # Personal access token (read-only scope sufficient)
GITHUB_WEBHOOK_SECRET=                     # Optional: shared secret for GitHub push webhooks (POST /api/webhook/github)

# pgvector (PostgreSQL) — vector store, shared with Egeria Advisor's own
# egeria_advisor database (see PgVectorConfig in resource_explorer/config.py).
# Defaults below match the shared instance managed by egeria-workspaces-fs's
# compose-configs/shared-infra/shared-infra.yaml (pgvector/pgvector:pg17,
# port 5442) — override only for a from-scratch environment without it, or
# a small local `docker run -p 5442:5432 pgvector/pgvector:pg17` for one.
# PGVECTOR_HOST=localhost
# PGVECTOR_PORT=5442
# PGVECTOR_DBNAME=egeria_advisor
# PGVECTOR_USER=egeria_advisor
# PGVECTOR_PASSWORD=advisor
# PGVECTOR_SCHEMA=resource_explorer

# Registry (project/resource metadata) — defaults to the same shared
# Postgres instance/database as pgvector above, in its own `resource_explorer`
# schema (see RegistryConfig in resource_explorer/config.py). Override to
# fall back to a local SQLite file for a from-scratch environment:
# REGISTRY_DATABASE_URL=sqlite:///data/registry.db

# LLM backend: ollama | openai | anthropic
LLM__BACKEND=ollama
LLM__OLLAMA__BASE_URL=http://localhost:11434
LLM__OLLAMA__MODEL=llama3.1:8b
LLM__OPENAI__MODEL=gpt-4o-mini
LLM__ANTHROPIC__MODEL=claude-haiku-4-5-20251001

# API keys (standard flat names — loaded directly by the SDK clients)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings
EMBEDDINGS__MODEL=all-MiniLM-L6-v2        # sentence-transformers model name
EMBEDDINGS__DEVICE=                        # auto-detected: mps | cuda | cpu

# Observability
OBSERVABILITY__MLFLOW__ENABLED=true
OBSERVABILITY__MLFLOW__TRACKING_URI=http://localhost:5025
OBSERVABILITY__PHOENIX__ENABLED=true
OBSERVABILITY__PHOENIX__COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
OBSERVABILITY__METRICS_DB=data/metrics.db

# Query cache
CACHE__TTL_SECONDS=3600
CACHE__MAX_SIZE=1000
# CACHE__BACKEND=redis
# CACHE__REDIS_URL=redis://localhost:6379

# RAG tuning
RAG__TOP_K=10
RAG__MIN_SCORE=0.15
RAG__MAX_COLLECTIONS_PER_QUERY=3


# Egeria integration (optional — required only for --publish / --refresh)
# Uses standard pyegeria env var names; falls back to pyegeria's config/config.json if unset.
EGERIA_PLATFORM_URL=https://localhost:9443
EGERIA_VIEW_SERVER=qs-view-server
EGERIA_USER=erinoverview
EGERIA_USER_PASSWORD=secret
PYEGERIA_TIMEOUT_SECONDS=30
# Default governance zones assigned to assets when cataloging (comma-separated JSON list)
# EGERIA__DEFAULT_CATALOG_ZONES=["data-lake","analytics"]
# EGERIA__DEFAULT_SURVEY_ZONES=["survey-zone"]

# Kroki (optional — self-hosted mermaid diagram rendering). Defaults to the
# shared egeria-shared-kroki container's published host port (6002 — moved off
# Kroki's own default 8000, which collided with common local dev servers like
# `mkdocs serve`) in a Trellis checkout; see
# egeria-workspaces-fs/compose-configs/shared-infra/shared-infra.yaml.
KROKI_URL=http://localhost:6002

# Prefect (optional — distributed execution for locally-run survey steps only;
# does NOT apply to executes_at: egeria steps, which Egeria coordinates itself
# and RE has no visibility into either way). See docs/Backlog.md's "Distributed
# survey orchestration via a flow tool (Prefect)" entry and
# docs/distributed-survey-orchestration.md for the full design.
#
# Requires a local Prefect server + a deployed flow + a running worker — see
# CLAUDE.md's "External services" section for the setup commands. With no
# server reachable, steps fall back to running locally exactly as if
# PREFECT_ENABLED were false — the values below are safe to enable without
# one, they just add per-step connection-attempt overhead until a server
# exists.
PREFECT_API_URL=http://localhost:4200/api
PREFECT_UI_URL=http://localhost:4200
PREFECT_ENABLED=true
PREFECT_WORK_POOL=default-agent-pool
# Also route plain executes_at: resource-explorer steps through Prefect, not
# just steps that explicitly declare executes_at: prefect. Off by default
# even with PREFECT_ENABLED=true — see PrefectConfig.route_local_steps'
# docstring in config.py for why this is a separate, deliberate opt-in.
PREFECT_ROUTE_LOCAL_STEPS=false
